{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-for-mobile.local/contracts/tablet-layout-observation-offline-summary-v2.schema.json",
  "title": "Tablet T-L1 v2 diagnostic-only offline gate summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "gate_run_id", "started_at", "finished_at", "suite", "status", "test_exit_code",
    "total_cases", "passed_cases", "failed_cases", "required_coverage_count",
    "covered_required_count", "coverage_ids", "cases", "fixture_contract_only", "runtime_evidence",
    "layout_accepted", "wechat_layout_verified", "editor_action_ready", "settings_mutation_allowed",
    "device_action_allowed", "p0_capability", "execution_grant"
  ],
  "properties": {
    "schema": { "const": "tablet-layout-observation-offline-summary/v2" },
    "gate_run_id": { "type": "string", "pattern": "^gate-[0-9a-f]{32}$" },
    "started_at": { "$ref": "#/$defs/timestamp" },
    "finished_at": { "$ref": "#/$defs/timestamp" },
    "suite": { "const": "tablet-layout-observation/v2" },
    "status": { "enum": ["passed", "failed"] },
    "test_exit_code": { "type": "integer", "minimum": 0, "maximum": 255 },
    "total_cases": { "type": "integer", "minimum": 0, "maximum": 128 },
    "passed_cases": { "type": "integer", "minimum": 0, "maximum": 128 },
    "failed_cases": { "type": "integer", "minimum": 0, "maximum": 128 },
    "required_coverage_count": { "type": "integer", "minimum": 1, "maximum": 64 },
    "covered_required_count": { "type": "integer", "minimum": 0, "maximum": 64 },
    "coverage_ids": {
      "type": "array", "maxItems": 64, "uniqueItems": true,
      "items": { "$ref": "#/$defs/coverageId" }
    },
    "cases": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/caseResult" } },
    "fixture_contract_only": { "const": true },
    "runtime_evidence": { "const": false },
    "layout_accepted": { "const": false },
    "wechat_layout_verified": { "const": false },
    "editor_action_ready": { "const": false },
    "settings_mutation_allowed": { "const": false },
    "device_action_allowed": { "const": false },
    "p0_capability": { "const": "unsupported" },
    "execution_grant": { "const": false }
  },
  "$defs": {
    "timestamp": {
      "type": "string", "minLength": 28, "maxLength": 28,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{7}Z$"
    },
    "coverageId": {
      "type": "string", "minLength": 1, "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "caseResult": {
      "type": "object", "additionalProperties": false,
      "required": ["case_id", "status", "coverage_ids"],
      "properties": {
        "case_id": { "type": "string", "minLength": 3, "maxLength": 80, "pattern": "^[a-z][a-z0-9-]{2,79}$" },
        "status": { "enum": ["passed", "failed"] },
        "coverage_ids": {
          "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
          "items": { "$ref": "#/$defs/coverageId" }
        }
      }
    }
  }
}
