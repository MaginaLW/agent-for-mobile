{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-for-mobile.local/contracts/tablet-layout-c1b-sidecar-v1.schema.json",
  "title": "Tablet T-L1 C1b v1 independently bound trusted-runtime sidecar",
  "type": "object", "additionalProperties": false,
  "required": ["schema","run_id","completed_at_utc","expected_commit_sha","capture_scope","provenance_strategy","static_read_only_policy_version","implementation_hashes","transport","apk","device","upstream_t0","provider","capture","artifacts","read_only_counts","attestations","claims","cleanup"],
  "properties": {
    "schema": { "const": "tablet-layout-c1b-sidecar/v1" }, "run_id": { "$ref": "#/$defs/safeId" },
    "completed_at_utc": { "$ref": "#/$defs/timestamp" }, "expected_commit_sha": { "$ref": "#/$defs/gitSha" },
    "capture_scope": { "const": "pure_a11y" }, "provenance_strategy": { "const": "clean_content_provider_independently_attested" },
    "static_read_only_policy_version": { "const": "tl1-c1b-read-only/v1" },
    "implementation_hashes": { "$ref": "#/$defs/implementationHashes" }, "transport": { "$ref": "#/$defs/transport" }, "apk": { "$ref": "#/$defs/apk" },
    "device": { "$ref": "#/$defs/device" }, "upstream_t0": { "$ref": "#/$defs/upstreamT0" },
    "provider": { "$ref": "#/$defs/provider" }, "capture": { "$ref": "#/$defs/capture" },
    "artifacts": { "$ref": "#/$defs/artifacts" }, "read_only_counts": { "$ref": "#/$defs/readOnlyCounts" },
    "attestations": { "$ref": "#/$defs/attestations" }, "claims": { "$ref": "#/$defs/claims" },
    "cleanup": { "$ref": "#/$defs/cleanup" }
  },
  "$defs": {
    "safeId": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$" },
    "safeVersion": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$" },
    "hash": { "type": "string", "minLength": 71, "maxLength": 71, "pattern": "^sha256:[0-9a-f]{64}$" },
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "timestamp": { "type": "string", "minLength": 28, "maxLength": 28, "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{7}Z$" },
    "relativeJsonPath": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]{0,199}\\.json$" },
    "implementationHashes": {
      "type": "object", "additionalProperties": false,
      "required": ["runner_sha256","c1b_library_sha256","c1a_low_level_library_sha256","t0_runner_sha256","t0_library_sha256","t0_adb_sidecar_cmd_sha256","t0_adb_sidecar_script_sha256","validator_sha256","native_path_validator_sha256","observation_schema_sha256","sidecar_schema_sha256","android_model_sha256","android_probe_sha256","android_source_sha256","android_provider_sha256","android_protocol_sha256","android_coordinator_sha256","android_controller_sha256","android_context_sha256","android_pending_registry_sha256","debug_manifest_sha256","gateway_build_gradle_sha256"],
      "properties": {
        "runner_sha256": { "$ref": "#/$defs/hash" }, "c1b_library_sha256": { "$ref": "#/$defs/hash" },
        "c1a_low_level_library_sha256": { "$ref": "#/$defs/hash" }, "t0_runner_sha256": { "$ref": "#/$defs/hash" },
        "t0_library_sha256": { "$ref": "#/$defs/hash" }, "t0_adb_sidecar_cmd_sha256": { "$ref": "#/$defs/hash" },
        "t0_adb_sidecar_script_sha256": { "$ref": "#/$defs/hash" }, "validator_sha256": { "$ref": "#/$defs/hash" }, "native_path_validator_sha256": { "$ref": "#/$defs/hash" },
        "observation_schema_sha256": { "$ref": "#/$defs/hash" }, "sidecar_schema_sha256": { "$ref": "#/$defs/hash" },
        "android_model_sha256": { "$ref": "#/$defs/hash" }, "android_probe_sha256": { "$ref": "#/$defs/hash" },
        "android_source_sha256": { "$ref": "#/$defs/hash" }, "android_provider_sha256": { "$ref": "#/$defs/hash" },
        "android_protocol_sha256": { "$ref": "#/$defs/hash" }, "android_coordinator_sha256": { "$ref": "#/$defs/hash" },
        "android_controller_sha256": { "$ref": "#/$defs/hash" }, "android_context_sha256": { "$ref": "#/$defs/hash" },
        "android_pending_registry_sha256": { "$ref": "#/$defs/hash" }, "debug_manifest_sha256": { "$ref": "#/$defs/hash" },
        "gateway_build_gradle_sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "transport": {
      "type": "object", "additionalProperties": false,
      "required": ["trust_root","canonical_relative_path","sdk_roots_equal","executable_sha256_before","executable_sha256_after","version_output_sha256_before","version_output_sha256_after","protocol_version","package_version","installed_as_canonical"],
      "properties": {
        "trust_root": { "const": "android_sdk_platform_tools" }, "canonical_relative_path": { "const": "platform-tools/adb.exe" },
        "sdk_roots_equal": { "const": true }, "executable_sha256_before": { "$ref": "#/$defs/hash" }, "executable_sha256_after": { "$ref": "#/$defs/hash" },
        "version_output_sha256_before": { "$ref": "#/$defs/hash" }, "version_output_sha256_after": { "$ref": "#/$defs/hash" },
        "protocol_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }, "package_version": { "$ref": "#/$defs/safeVersion" },
        "installed_as_canonical": { "const": true }
      }
    },
    "apk": {
      "type": "object", "additionalProperties": false,
      "required": ["fresh_build","install_attempt_count","uninstall_count","automatic_retry_count","local_sha256_before","local_sha256_after","installed_base_apk_path_hash_before","installed_base_apk_path_hash_after","installed_base_apk_sha256_before","installed_base_apk_sha256_after","signer_certificate_sha256","package_name_before","package_name_after","version_name_before","version_name_after","version_code_before","version_code_after"],
      "properties": {
        "fresh_build": { "const": true }, "install_attempt_count": { "const": 1 }, "uninstall_count": { "const": 0 }, "automatic_retry_count": { "const": 0 },
        "local_sha256_before": { "$ref": "#/$defs/hash" }, "local_sha256_after": { "$ref": "#/$defs/hash" },
        "installed_base_apk_path_hash_before": { "$ref": "#/$defs/hash" }, "installed_base_apk_path_hash_after": { "$ref": "#/$defs/hash" },
        "installed_base_apk_sha256_before": { "$ref": "#/$defs/hash" }, "installed_base_apk_sha256_after": { "$ref": "#/$defs/hash" },
        "signer_certificate_sha256": { "$ref": "#/$defs/hash" }, "package_name_before": { "const": "dev.magina.gateway" },
        "package_name_after": { "const": "dev.magina.gateway" }, "version_name_before": { "$ref": "#/$defs/safeVersion" },
        "version_name_after": { "$ref": "#/$defs/safeVersion" }, "version_code_before": { "type": "integer", "minimum": 1 },
        "version_code_after": { "type": "integer", "minimum": 1 }
      }
    },
    "device": {
      "type": "object", "additionalProperties": false,
      "required": ["serial_hash_before","serial_hash_after","fingerprint_hash_before","fingerprint_hash_after","boot_id_hash_before","boot_id_hash_after","unique_device_before_after"],
      "properties": {
        "serial_hash_before": { "$ref": "#/$defs/hash" }, "serial_hash_after": { "$ref": "#/$defs/hash" },
        "fingerprint_hash_before": { "$ref": "#/$defs/hash" }, "fingerprint_hash_after": { "$ref": "#/$defs/hash" },
        "boot_id_hash_before": { "$ref": "#/$defs/hash" }, "boot_id_hash_after": { "$ref": "#/$defs/hash" },
        "unique_device_before_after": { "const": true }
      }
    },
    "upstreamT0": {
      "type": "object", "additionalProperties": false,
      "required": ["producer_commit_sha","original_relative_path","original_sha256","original_byte_count","original_crlf_count","original_bytes_forwarded","exec_in_write_count","device_binding_verified"],
      "properties": {
        "producer_commit_sha": { "const": "4ca32b131007df58f7752c5ee9b2d049cb1cd54e" }, "original_relative_path": { "$ref": "#/$defs/relativeJsonPath" },
        "original_sha256": { "$ref": "#/$defs/hash" }, "original_byte_count": { "type": "integer", "minimum": 1, "maximum": 65536 },
        "original_crlf_count": { "type": "integer", "minimum": 0, "maximum": 65536 }, "original_bytes_forwarded": { "const": true },
        "exec_in_write_count": { "const": 1 }, "device_binding_verified": { "const": true }
      }
    },
    "provider": {
      "type": "object", "additionalProperties": false,
      "required": ["authority","protocol_version","package_name","version_name","version_code","embedded_git_head","build_challenge_hash","expected_title_hash","producer_artifact_sha256","a11y_service_ready","control_transcript_sha256","endpoint_set_sha256"],
      "properties": {
        "authority": { "const": "dev.magina.gateway.tablet.c1b" }, "protocol_version": { "const": "1" }, "package_name": { "const": "dev.magina.gateway" },
        "version_name": { "$ref": "#/$defs/safeVersion" }, "version_code": { "type": "integer", "minimum": 1 }, "embedded_git_head": { "$ref": "#/$defs/gitSha" },
        "build_challenge_hash": { "$ref": "#/$defs/hash" }, "expected_title_hash": { "const": "sha256:5d3510ec998c991305fcede15b32be9ea1c4061d82ab15a3994a38faa243311c" },
        "producer_artifact_sha256": { "$ref": "#/$defs/hash" }, "a11y_service_ready": { "const": true },
        "control_transcript_sha256": { "$ref": "#/$defs/hash" }, "endpoint_set_sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "capture": {
      "type": "object", "additionalProperties": false,
      "required": ["generation","c1_requested_at_utc","c1_committed_at_utc","c2_requested_at_utc","c2_committed_at_utc","host_wait_ms","total_span_ms","status_poll_count","c1_requests_accepted","c2_requests_accepted","result_read_count","recapture_count"],
      "properties": {
        "generation": { "type": "integer", "minimum": 1 }, "c1_requested_at_utc": { "$ref": "#/$defs/timestamp" },
        "c1_committed_at_utc": { "$ref": "#/$defs/timestamp" }, "c2_requested_at_utc": { "$ref": "#/$defs/timestamp" },
        "c2_committed_at_utc": { "$ref": "#/$defs/timestamp" }, "host_wait_ms": { "type": "integer", "minimum": 900, "maximum": 15000 },
        "total_span_ms": { "type": "integer", "minimum": 900, "maximum": 15000 }, "status_poll_count": { "type": "integer", "minimum": 1, "maximum": 100 },
        "c1_requests_accepted": { "const": 1 }, "c2_requests_accepted": { "const": 1 }, "result_read_count": { "const": 1 }, "recapture_count": { "const": 0 }
      }
    },
    "artifact": { "type": "object", "additionalProperties": false, "required": ["relative_path","sha256"], "properties": { "relative_path": { "$ref": "#/$defs/relativeJsonPath" }, "sha256": { "$ref": "#/$defs/hash" } } },
    "artifacts": { "type": "object", "additionalProperties": false, "required": ["upstream_t0","observation","validation"], "properties": { "upstream_t0": { "$ref": "#/$defs/artifact" }, "observation": { "$ref": "#/$defs/artifact" }, "validation": { "$ref": "#/$defs/artifact" } } },
    "readOnlyCounts": {
      "type": "object", "additionalProperties": false,
      "required": ["a11y_frame_capture_count","recapture_count","display_screenshot_call_count","window_screenshot_call_count","ocr_invocation_count","action_call_count","gesture_call_count","input_call_count","settings_mutation_count","target_app_start_count","mcp_call_count","dispatch_call_count"],
      "properties": {
        "a11y_frame_capture_count": { "const": 2 }, "recapture_count": { "const": 0 }, "display_screenshot_call_count": { "const": 0 },
        "window_screenshot_call_count": { "const": 0 }, "ocr_invocation_count": { "const": 0 }, "action_call_count": { "const": 0 },
        "gesture_call_count": { "const": 0 }, "input_call_count": { "const": 0 }, "settings_mutation_count": { "const": 0 },
        "target_app_start_count": { "const": 0 }, "mcp_call_count": { "const": 0 }, "dispatch_call_count": { "const": 0 }
      }
    },
    "attestations": {
      "type": "object", "additionalProperties": false,
      "required": ["full_clean_head_verified","implementation_hashes_verified","origin_binding_verified","probe_entrypoint_read_only","observation_schema_valid","artifact_hashes_recomputed"],
      "properties": { "full_clean_head_verified": { "const": true }, "implementation_hashes_verified": { "const": true }, "origin_binding_verified": { "const": true }, "probe_entrypoint_read_only": { "const": true }, "observation_schema_valid": { "const": true }, "artifact_hashes_recomputed": { "const": true } }
    },
    "claims": {
      "type": "object", "additionalProperties": false,
      "required": ["runtime_origin_verified","runtime_evidence","wechat_window_ownership_observed","wechat_window_ownership_verified","window_root_projection_observed","window_root_projection_verified","application_window_topology_observed","application_window_topology_verified","ime_hidden_observed","ime_hidden_verified","semantic_tree_usable","navigation_pane_verified","conversation_pane_verified","target_conversation_verified","target_regions_verified","layout_accepted","wechat_layout_verified","editor_action_ready","p0_capability","execution_grant"],
      "properties": {
        "runtime_origin_verified": { "const": true }, "runtime_evidence": { "const": true }, "wechat_window_ownership_observed": { "type": "boolean" },
        "wechat_window_ownership_verified": { "type": "boolean" }, "window_root_projection_observed": { "type": "boolean" }, "window_root_projection_verified": { "type": "boolean" },
        "application_window_topology_observed": { "type": "boolean" }, "application_window_topology_verified": { "type": "boolean" },
        "ime_hidden_observed": { "type": "boolean" }, "ime_hidden_verified": { "type": "boolean" }, "semantic_tree_usable": { "type": "boolean" },
        "navigation_pane_verified": { "const": false }, "conversation_pane_verified": { "const": false }, "target_conversation_verified": { "const": false },
        "target_regions_verified": { "const": false }, "layout_accepted": { "const": false }, "wechat_layout_verified": { "const": false },
        "editor_action_ready": { "const": false }, "p0_capability": { "const": "unsupported" }, "execution_grant": { "const": false }
      },
      "allOf": [{ "$ref": "#/$defs/ownershipClaims" },{ "$ref": "#/$defs/rootProjectionClaims" },{ "$ref": "#/$defs/topologyClaims" },{ "$ref": "#/$defs/imeClaims" }]
    },
    "ownershipClaims": { "if": { "properties": { "wechat_window_ownership_observed": { "const": true } }, "required": ["wechat_window_ownership_observed"] }, "then": { "properties": { "wechat_window_ownership_verified": { "const": true } } }, "else": { "properties": { "wechat_window_ownership_verified": { "const": false } } } },
    "rootProjectionClaims": { "if": { "properties": { "window_root_projection_observed": { "const": true } }, "required": ["window_root_projection_observed"] }, "then": { "properties": { "window_root_projection_verified": { "const": true } } }, "else": { "properties": { "window_root_projection_verified": { "const": false } } } },
    "topologyClaims": { "if": { "properties": { "application_window_topology_observed": { "const": true } }, "required": ["application_window_topology_observed"] }, "then": { "properties": { "application_window_topology_verified": { "const": true } } }, "else": { "properties": { "application_window_topology_verified": { "const": false } } } },
    "imeClaims": { "if": { "properties": { "ime_hidden_observed": { "const": true } }, "required": ["ime_hidden_observed"] }, "then": { "properties": { "ime_hidden_verified": { "const": true } } }, "else": { "properties": { "ime_hidden_verified": { "const": false } } } },
    "cleanup": { "type": "object", "additionalProperties": false, "required": ["required","status","abort_attempt_count"], "properties": { "required": { "const": false }, "status": { "const": "not_required" }, "abort_attempt_count": { "const": 0 } } }
  }
}
