{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tablet-layout-c1a-sidecar-v1.schema.json",
  "title": "T-L1 C1a origin-binding sidecar v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "run_id", "completed_at_utc", "expected_commit_sha", "provenance_strategy",
    "static_read_only_policy_version", "trusted_blobs", "implementation_hashes", "producer_baseline_sha",
    "t0_baseline_sha", "title_hash", "apk", "device", "upstream_t0", "capture", "observation", "validation",
    "c1a_origin_binding_verified", "c1a_probe_entrypoint_read_only", "observation_schema_valid",
    "mcp_used", "dispatch_used", "screen_capture_used", "settings_mutation_used", "target_app_started", "cleanup_status",
    "runtime_evidence", "layout_accepted", "wechat_layout_verified", "editor_action_ready",
    "p0_capability", "execution_grant"
  ],
  "properties": {
    "schema": { "const": "tablet-layout-c1a-sidecar/v1" },
    "run_id": { "$ref": "#/$defs/safeId" },
    "completed_at_utc": { "$ref": "#/$defs/timestamp" },
    "expected_commit_sha": { "$ref": "#/$defs/gitSha" },
    "provenance_strategy": { "const": "clean_port_content_attested" },
    "static_read_only_policy_version": { "const": "tl1-c1a-read-only/v1" },
    "trusted_blobs": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "prefixItems": [
        { "$ref": "#/$defs/blob1" }, { "$ref": "#/$defs/blob2" }, { "$ref": "#/$defs/blob3" },
        { "$ref": "#/$defs/blob4" }, { "$ref": "#/$defs/blob5" }, { "$ref": "#/$defs/blob6" }
      ],
      "items": false
    },
    "implementation_hashes": {
      "type": "object", "additionalProperties": false,
      "required": [
        "runner_sha256", "c1a_library_sha256", "t0_adb_sidecar_cmd_sha256",
        "t0_adb_sidecar_script_sha256", "validator_sha256", "sidecar_schema_sha256"
      ],
      "properties": {
        "runner_sha256": { "$ref": "#/$defs/hash" },
        "c1a_library_sha256": { "$ref": "#/$defs/hash" },
        "t0_adb_sidecar_cmd_sha256": { "$ref": "#/$defs/hash" },
        "t0_adb_sidecar_script_sha256": { "$ref": "#/$defs/hash" },
        "validator_sha256": { "$ref": "#/$defs/hash" },
        "sidecar_schema_sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "producer_baseline_sha": { "const": "b5769df7baba075fda47aec17f249a5caa124b92" },
    "t0_baseline_sha": { "const": "4ca32b131007df58f7752c5ee9b2d049cb1cd54e" },
    "title_hash": { "const": "sha256:5d3510ec998c991305fcede15b32be9ea1c4061d82ab15a3994a38faa243311c" },
    "apk": {
      "type": "object", "additionalProperties": false,
      "required": [
        "local_sha256_before", "local_sha256_after", "installed_base_apk_path_hash_before",
        "installed_base_apk_path_hash_after", "installed_base_apk_sha256_before",
        "installed_base_apk_sha256_after", "signer_certificate_sha256", "package_name_before",
        "package_name_after", "version_name_before", "version_name_after", "version_code_before",
        "version_code_after", "embedded_git_head", "build_challenge_hash"
      ],
      "properties": {
        "local_sha256_before": { "$ref": "#/$defs/hash" },
        "local_sha256_after": { "$ref": "#/$defs/hash" },
        "installed_base_apk_path_hash_before": { "$ref": "#/$defs/hash" },
        "installed_base_apk_path_hash_after": { "$ref": "#/$defs/hash" },
        "installed_base_apk_sha256_before": { "$ref": "#/$defs/hash" },
        "installed_base_apk_sha256_after": { "$ref": "#/$defs/hash" },
        "signer_certificate_sha256": { "$ref": "#/$defs/hash" },
        "package_name_before": { "const": "dev.magina.gateway" },
        "package_name_after": { "const": "dev.magina.gateway" },
        "version_name_before": { "$ref": "#/$defs/safeId" },
        "version_name_after": { "$ref": "#/$defs/safeId" },
        "version_code_before": { "type": "integer", "minimum": 1 },
        "version_code_after": { "type": "integer", "minimum": 1 },
        "embedded_git_head": { "$ref": "#/$defs/gitSha" },
        "build_challenge_hash": { "$ref": "#/$defs/hash" }
      }
    },
    "device": {
      "type": "object", "additionalProperties": false,
      "required": [
        "serial_hash_before", "serial_hash_after", "fingerprint_hash_before", "fingerprint_hash_after",
        "boot_id_hash_before", "boot_id_hash_after", "unique_device_before_after"
      ],
      "properties": {
        "serial_hash_before": { "$ref": "#/$defs/hash" },
        "serial_hash_after": { "$ref": "#/$defs/hash" },
        "fingerprint_hash_before": { "$ref": "#/$defs/hash" },
        "fingerprint_hash_after": { "$ref": "#/$defs/hash" },
        "boot_id_hash_before": { "$ref": "#/$defs/hash" },
        "boot_id_hash_after": { "$ref": "#/$defs/hash" },
        "unique_device_before_after": { "const": true }
      }
    },
    "upstream_t0": {
      "type": "object", "additionalProperties": false,
      "required": ["producer_commit_sha", "artifact_sha256", "original_bytes_forwarded"],
      "properties": {
        "producer_commit_sha": { "const": "4ca32b131007df58f7752c5ee9b2d049cb1cd54e" },
        "artifact_sha256": { "$ref": "#/$defs/hash" },
        "original_bytes_forwarded": { "const": true }
      }
    },
    "capture": {
      "type": "object", "additionalProperties": false,
      "required": ["tokens", "host_wait_ms", "total_span_ms", "recapture_count"],
      "properties": {
        "tokens": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "prefixItems": [{ "const": "c1" }, { "const": "c2" }], "items": false
        },
        "host_wait_ms": { "type": "integer", "minimum": 900, "maximum": 15000 },
        "total_span_ms": { "type": "integer", "minimum": 900, "maximum": 15000 },
        "recapture_count": { "const": 0 }
      }
    },
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_sha256", "relative_path"],
      "properties": {
        "artifact_sha256": { "$ref": "#/$defs/hash" },
        "relative_path": { "const": "tablet-layout-observation-v2.json" }
      }
    },
    "validation": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_sha256", "relative_path"],
      "properties": {
        "artifact_sha256": { "$ref": "#/$defs/hash" },
        "relative_path": { "const": "tablet-layout-observation-validation-v2.json" }
      }
    },
    "c1a_origin_binding_verified": { "const": true },
    "c1a_probe_entrypoint_read_only": { "const": true },
    "observation_schema_valid": { "const": true },
    "mcp_used": { "const": false },
    "dispatch_used": { "const": false },
    "screen_capture_used": { "const": false },
    "settings_mutation_used": { "const": false },
    "target_app_started": { "const": false },
    "cleanup_status": { "const": "not_required" },
    "runtime_evidence": { "const": false },
    "layout_accepted": { "const": false },
    "wechat_layout_verified": { "const": false },
    "editor_action_ready": { "const": false },
    "p0_capability": { "const": "unsupported" },
    "execution_grant": { "const": false }
  },
  "$defs": {
    "safeId": {
      "type": "string", "minLength": 1, "maxLength": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
    },
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "timestamp": {
      "type": "string", "minLength": 28, "maxLength": 28,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{7}Z$"
    },
    "blob1": { "$ref": "#/$defs/blobBase", "properties": { "path": { "const": "app/gateway/src/main/java/dev/magina/gateway/tablet/AndroidTabletLayoutProbeSource.kt" }, "blob_oid": { "const": "cf5f625650d81e830da8e03b2ee8ebf5ce309b7a" } } },
    "blob2": { "$ref": "#/$defs/blobBase", "properties": { "path": { "const": "app/gateway/src/main/java/dev/magina/gateway/tablet/TabletLayoutProbe.kt" }, "blob_oid": { "const": "b7b35d1d0c4c1787f1f254224c8ac13ee1668cf7" } } },
    "blob3": { "$ref": "#/$defs/blobBase", "properties": { "path": { "const": "app/gateway/src/main/java/dev/magina/gateway/tablet/TabletLayoutProbeModel.kt" }, "blob_oid": { "const": "283eb71675605444c5f829aea9b1c9fd9bd65db0" } } },
    "blob4": { "$ref": "#/$defs/blobBase", "properties": { "path": { "const": "app/gateway/src/test/java/dev/magina/gateway/tablet/TabletLayoutProbeTest.kt" }, "blob_oid": { "const": "70843bb488041c5e21204f973c4dbcac526a126e" } } },
    "blob5": { "$ref": "#/$defs/blobBase", "properties": { "path": { "const": "scripts/lib/tablet-intake.ps1" }, "blob_oid": { "const": "4d33c629b95a13a59bb97bdf1490e1edc74b17b4" } } },
    "blob6": { "$ref": "#/$defs/blobBase", "properties": { "path": { "const": "scripts/run-tablet-intake.ps1" }, "blob_oid": { "const": "572da0c848eefd038ea666d80d741fb73767eb48" } } },
    "blobBase": {
      "type": "object", "additionalProperties": false, "required": ["path", "blob_oid"],
      "properties": { "path": { "type": "string" }, "blob_oid": { "type": "string", "pattern": "^[0-9a-f]{40}$" } }
    }
  }
}
