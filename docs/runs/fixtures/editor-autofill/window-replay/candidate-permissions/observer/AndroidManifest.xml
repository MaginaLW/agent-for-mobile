<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="dev.magina.publicwindow">
    <uses-sdk android:minSdkVersion="36" android:targetSdkVersion="35" />
    <application android:allowBackup="false" android:debuggable="true" android:label="只读通道对照">
        <service android:name=".WindowProbe" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE" android:exported="false">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/window" />
        </service>
        <service android:name=".ImeProbe" android:exported="true" android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter><action android:name="android.view.InputMethod" /></intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/method" />
        </service>
    </application>
</manifest>
