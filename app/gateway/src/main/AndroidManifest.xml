<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- system_get_state(wifi)=WifiManager.isWifiEnabled 需要（真机日首跑实锤：缺则 SecurityException） -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!--
        app_launch 只需要解析技能包 apps.json 已登记目标的 launcher activity；精确包查询
        与 aliases 保持一一对应（由 PackageVisibilityManifestTest 钉住），不授予全量应用可见性。
    -->
    <queries>
        <package android:name="com.tencent.mm" />
        <package android:name="com.xingin.xhs" />
        <package android:name="com.jingdong.app.mall" />
        <package android:name="com.taobao.taobao" />
        <package android:name="com.tmall.wireless" />
        <package android:name="com.eg.android.AlipayGphone" />
        <package android:name="com.android.settings" />
        <package android:name="com.vivo.gallery" />
    </queries>

    <application
        android:label="执行网关"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Material.Light">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            通知栏“拒绝”回执的落点（批次 2）；批准只来自可见确认卡，不经过广播。
            exported=false 是安全要求，不是习惯：只有本进程发出的显式广播能到这里。
            配合唯一、immutable、one-shot 的 PendingIntent 与一次性 nonce，旧句柄不能复用。

            **刻意没有声明 USE_FULL_SCREEN_INTENT**（B 道决定二）：FSI 的作用正是把整页免解锁
            糊到锁屏上，而锁屏那一层已经用 VISIBILITY_PRIVATE 把明文挡在外面，两者直接冲突。
        -->
        <receiver
            android:name=".overlay.ConfirmDecisionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="dev.magina.gateway.APPROVAL_DECISION" />
            </intent-filter>
        </receiver>

        <!-- 前台服务：承载嵌入式 MCP server -->
        <service
            android:name=".GatewayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="embedded MCP server for phone-agent gateway" />
        </service>

        <!-- L4：无障碍执行通道 -->
        <service
            android:name=".a11y.GatewayA11yService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/a11y_config" />
        </service>

        <!-- 自有 IME：中文/空格/换行字面注入通道（spec §8） -->
        <service
            android:name=".ime.GatewayIme"
            android:exported="true"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/ime_method" />
        </service>
    </application>
</manifest>
