{
  "id": "bili_readonly_prepare",
  "version": 1,
  "app": "哔哩哔哩",
  "expect_package": "tv.danmaku.bili",
  "description": "纯只读检查前台非系统拦截后拉起哔哩哔哩，等待前台与列表稳定并采集完整快照交回大脑阅读；严禁任何点击、输入、互动或代登录。",
  "readonly": true,
  "verified": "",
  "params": {},
  "steps": [
    {
      "id": "check_foreground",
      "tool": "foreground_app",
      "args": {},
      "assertions": {
        "not_packages": ["com.vivo.appfilter"]
      }
    },
    {
      "id": "launch_bili",
      "tool": "app_launch",
      "args": {
        "name": "哔哩哔哩"
      }
    },
    {
      "id": "wait_bili_foreground",
      "tool": "wait_for",
      "args": {
        "condition": "app_foreground",
        "package": "tv.danmaku.bili",
        "timeout_ms": 5000
      }
    },
    {
      "id": "wait_bili_settle",
      "tool": "wait_for",
      "args": {
        "condition": "idle",
        "quiet_ms": 800,
        "timeout_ms": 5000
      }
    },
    {
      "id": "read_bili_snapshot",
      "tool": "ui_snapshot",
      "args": {
        "scope": "full"
      },
      "capture_as_final_snapshot": true,
      "assertions": {
        "package_equals": "tv.danmaku.bili",
        "blocking_overlay_false": true,
        "no_login_wall": true
      }
    }
  ]
}