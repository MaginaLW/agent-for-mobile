{
  "id": "gallery_readonly_prepare",
  "version": 1,
  "app": "相册",
  "expect_package": "com.vivo.gallery",
  "description": "纯只读检查前台非系统拦截后拉起相册，等待前台与页面稳定并采集完整快照交回大脑阅读；严禁删除、编辑、重命名或对外分享照片。",
  "readonly": true,
  "verified": "",
  "params": {},
  "steps": [
    {
      "id": "check_foreground",
      "tool": "foreground_app",
      "args": {},
      "assertions": {
        "not_packages": ["com.vivo.appfilter"]
      }
    },
    {
      "id": "launch_gallery",
      "tool": "app_launch",
      "args": {
        "name": "相册"
      }
    },
    {
      "id": "wait_gallery_foreground",
      "tool": "wait_for",
      "args": {
        "condition": "app_foreground",
        "package": "com.vivo.gallery",
        "timeout_ms": 5000
      }
    },
    {
      "id": "wait_gallery_settle",
      "tool": "wait_for",
      "args": {
        "condition": "idle",
        "quiet_ms": 800,
        "timeout_ms": 5000
      }
    },
    {
      "id": "read_gallery_snapshot",
      "tool": "ui_snapshot",
      "args": {
        "scope": "full"
      },
      "capture_as_final_snapshot": true,
      "assertions": {
        "package_equals": "com.vivo.gallery",
        "blocking_overlay_false": true
      }
    }
  ]
}
