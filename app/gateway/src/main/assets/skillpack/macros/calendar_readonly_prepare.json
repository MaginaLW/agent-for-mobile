{
  "id": "calendar_readonly_prepare",
  "version": 1,
  "app": "日历",
  "expect_package": "com.bbk.calendar",
  "description": "纯只读检查前台非系统拦截后拉起日历，等待前台与页面稳定并采集完整快照交回大脑阅读；严禁新建、编辑、删除日程或订阅日历。",
  "readonly": true,
  "verified": "",
  "params": {},
  "steps": [
    {
      "id": "check_foreground",
      "tool": "foreground_app",
      "args": {},
      "assertions": {
        "not_packages": ["com.vivo.appfilter"]
      }
    },
    {
      "id": "launch_calendar",
      "tool": "app_launch",
      "args": {
        "name": "日历"
      }
    },
    {
      "id": "wait_calendar_foreground",
      "tool": "wait_for",
      "args": {
        "condition": "app_foreground",
        "package": "com.bbk.calendar",
        "timeout_ms": 5000
      }
    },
    {
      "id": "wait_calendar_settle",
      "tool": "wait_for",
      "args": {
        "condition": "idle",
        "quiet_ms": 800,
        "timeout_ms": 5000
      }
    },
    {
      "id": "read_calendar_snapshot",
      "tool": "ui_snapshot",
      "args": {
        "scope": "full"
      },
      "capture_as_final_snapshot": true,
      "assertions": {
        "package_equals": "com.bbk.calendar",
        "blocking_overlay_false": true
      }
    }
  ]
}
