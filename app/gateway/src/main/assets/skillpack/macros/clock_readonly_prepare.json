{
  "id": "clock_readonly_prepare",
  "version": 1,
  "app": "闹钟时钟",
  "expect_package": "com.android.BBKClock",
  "description": "纯只读检查前台非系统拦截后拉起闹钟时钟，等待前台与页面稳定并采集完整快照交回大脑阅读；严禁新增、修改、开关或删除闹钟。",
  "readonly": true,
  "verified": "",
  "params": {},
  "steps": [
    {
      "id": "check_foreground",
      "tool": "foreground_app",
      "args": {},
      "assertions": {
        "not_packages": ["com.vivo.appfilter"]
      }
    },
    {
      "id": "launch_clock",
      "tool": "app_launch",
      "args": {
        "name": "闹钟时钟"
      }
    },
    {
      "id": "wait_clock_foreground",
      "tool": "wait_for",
      "args": {
        "condition": "app_foreground",
        "package": "com.android.BBKClock",
        "timeout_ms": 5000
      }
    },
    {
      "id": "wait_clock_settle",
      "tool": "wait_for",
      "args": {
        "condition": "idle",
        "quiet_ms": 800,
        "timeout_ms": 5000
      }
    },
    {
      "id": "read_clock_snapshot",
      "tool": "ui_snapshot",
      "args": {
        "scope": "full"
      },
      "capture_as_final_snapshot": true,
      "assertions": {
        "package_equals": "com.android.BBKClock",
        "blocking_overlay_false": true
      }
    }
  ]
}
