{
  "id": "bili_readonly_feed_prepare",
  "version": 1,
  "app": "哔哩哔哩",
  "expect_package": "tv.danmaku.bili",
  "description": "深化只读前置宏：检查前台非系统拦截后拉起哔哩哔哩，若出现「暂不开启」推送提示则安全具名点击关闭（未出现时自动跳过），等待列表稳定后采集完整快照交回大脑阅读；严禁点击无标签图标或代登录。",
  "readonly": true,
  "verified": "2026-11-26",
  "params": {},
  "steps": [
    {
      "id": "check_foreground",
      "tool": "foreground_app",
      "args": {},
      "assertions": {
        "not_packages": ["com.vivo.appfilter"]
      }
    },
    {
      "id": "launch_bili",
      "tool": "app_launch",
      "args": {
        "name": "哔哩哔哩"
      }
    },
    {
      "id": "wait_bili_foreground",
      "tool": "wait_for",
      "args": {
        "condition": "app_foreground",
        "package": "tv.danmaku.bili",
        "timeout_ms": 5000
      }
    },
    {
      "id": "wait_bili_settle",
      "tool": "wait_for",
      "args": {
        "condition": "idle",
        "quiet_ms": 800,
        "timeout_ms": 5000
      }
    },
    {
      "id": "find_dismiss_push_prompt",
      "tool": "ui_find",
      "args": {
        "text": "暂不开启",
        "role": "button",
        "scroll_search": false
      },
      "optional": true,
      "save_ref": "dismiss_push"
    },
    {
      "id": "dismiss_push_prompt",
      "tool": "ui_action",
      "args": {
        "ref": "{{ref:dismiss_push}}",
        "action": "click"
      },
      "skip_if_ref_missing": true
    },
    {
      "id": "wait_after_dismiss_settle",
      "tool": "wait_for",
      "args": {
        "condition": "idle",
        "quiet_ms": 600,
        "timeout_ms": 4000
      }
    },
    {
      "id": "read_bili_snapshot",
      "tool": "ui_snapshot",
      "args": {
        "scope": "full"
      },
      "capture_as_final_snapshot": true,
      "assertions": {
        "package_equals": "tv.danmaku.bili",
        "blocking_overlay_false": true,
        "no_login_wall": true
      }
    }
  ]
}
