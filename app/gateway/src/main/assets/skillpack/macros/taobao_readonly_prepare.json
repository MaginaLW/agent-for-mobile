{
  "id": "taobao_readonly_prepare",
  "version": 1,
  "app": "淘宝",
  "expect_package": "com.taobao.taobao",
  "description": "检查前台非系统拦截后拉起淘宝，等待前台与页面稳定并采集只读完整快照交回大脑阅读；若遇系统拦截弹窗、登录墙或遮挡弹窗则断点交回大脑接管。",
  "readonly": true,
  "verified": "",
  "params": {},
  "steps": [
    {
      "id": "check_foreground",
      "tool": "foreground_app",
      "args": {},
      "assertions": {
        "not_packages": ["com.vivo.appfilter"]
      }
    },
    {
      "id": "launch_taobao",
      "tool": "app_launch",
      "args": {
        "name": "淘宝"
      }
    },
    {
      "id": "wait_taobao_foreground",
      "tool": "wait_for",
      "args": {
        "condition": "app_foreground",
        "package": "com.taobao.taobao",
        "timeout_ms": 5000
      }
    },
    {
      "id": "wait_taobao_settle",
      "tool": "wait_for",
      "args": {
        "condition": "idle",
        "quiet_ms": 800,
        "timeout_ms": 5000
      }
    },
    {
      "id": "read_taobao_snapshot",
      "tool": "ui_snapshot",
      "args": {
        "scope": "full"
      },
      "capture_as_final_snapshot": true,
      "assertions": {
        "package_equals": "com.taobao.taobao",
        "blocking_overlay_false": true,
        "no_login_wall": true
      }
    }
  ]
}
